name: reproduce

# 洛神 O1 · 核心结论第三方复现
#
# 意义：任何人 fork 本仓库，不必信任作者的声明 —— Actions 会在 GitHub
# 的干净机器上当场跑出全部核心数字，并用断言校验四条结论是否仍然成立。
# 结论若被推翻，这里会变红。这是本项目"可证伪"主张的机器化体现，
# 而不是一句口号。
#
# 依赖：仅 numpy。无 LLM、无网络、无构建步骤。

on:
  push:
    branches: [ main, master ]
  pull_request:
  workflow_dispatch:

jobs:
  verify:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: [ "3.10", "3.12" ]
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install（仅 numpy）
        run: |
          python -m pip install --upgrade pip
          pip install numpy

      - name: ① 五条硬约束断言
        run: python3 tests/test_engine.py

      - name: ② 核心结论复现（当场跑，不读存档、不写死常量）
        run: python3 experiments/run_core.py

      - name: ③ 四条核心结论断言（被推翻即变红）
        run: |
          python3 - <<'PY'
          import json, sys
          d = json.load(open("data/core_results.json"))
          ok = True
          def chk(name, cond, val):
              global ok
              print(("  [PASS] " if cond else "  [FAIL] ") + f"{name}  = {val}")
              if not cond: ok = False

          # 结论一：死亡是结构性可发生的（不是配置出来的）
          dead = [r for r in d["A_death"] if not r["survived"]]
          chk("① 死亡确实发生", len(dead) >= 1,
              f"{len(dead)}/{len(d['A_death'])} 个体死亡，death_t={[r['death_t'] for r in dead]}")

          # 结论二：早期剥夺有代价，且 8/8 符号一致
          b = d["B_tradeoff"]
          chk("② 早期剥夺 Δ < 0", b["mean_delta"] < 0, round(b["mean_delta"], 6))
          chk("② 符号一致", b["sign_consistent"] == b["n"],
              f"{b['sign_consistent']}/{b['n']}")

          # 结论三：结构性疤痕只在「稀缺 ∧ 不可逆」同时成立时出现，其余精确归零
          c = d["C_weld"]
          chk("③ 稀缺∧不可逆 → 疤痕 > 0", c["scarcity_1_irrev_1"]["mean_skew"] > 0,
              round(c["scarcity_1_irrev_1"]["mean_skew"], 6))
          for k in ("scarcity_1_irrev_0", "scarcity_0_irrev_1", "scarcity_0_irrev_0"):
              chk(f"③ {k} → 精确归零", c[k]["mean_skew"] == 0.0, c[k]["mean_skew"])

          # 结论四：早期引导强于全程施加（发育窗口）
          w = d["D_window"]
          chk("④ 早期引导 > 全程施加", w["early"]["mean"] > w["full"]["mean"],
              f"early={w['early']['mean']:.4f} > full={w['full']['mean']:.4f}")
          chk("④ 全程施加 > 晚期引导", w["full"]["mean"] > w["late"]["mean"],
              f"full={w['full']['mean']:.4f} > late={w['late']['mean']:.4f}")

          print("\n四条核心结论全部成立" if ok else "\n!! 结论被推翻 —— 这正是本流程存在的意义")
          sys.exit(0 if ok else 1)
          PY
